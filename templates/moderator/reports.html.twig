{% extends 'base.html.twig' %}

{% block title %}Скарги - Модератор{% endblock %}

{% block body %}
<div class="page-header d-flex justify-content-between align-items-center">
    <h1><i class="fas fa-flag me-2" style="color:var(--gf-danger)"></i>Скарги</h1>
    <a href="{{ path('app_moderator') }}" class="btn btn-gf-outline btn-sm"><i class="fas fa-arrow-left me-1"></i> Назад</a>
</div>

{% if reports is empty %}
    <div class="card-gf text-center py-5">
        <i class="fas fa-check-circle fa-3x mb-3" style="color:var(--gf-success)"></i>
        <h4>Скарг немає</h4>
        <p style="color:var(--gf-muted)">Все чисто!</p>
    </div>
{% else %}
    {% for report in reports %}
    <div class="card-gf mb-3">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
                <span class="me-2">
                    {% if report.status == 'pending' %}
                        <span class="badge-gf badge-gf-warning"><i class="fas fa-clock me-1"></i>Очікує</span>
                    {% elseif report.status == 'reviewed' %}
                        <span class="badge-gf"><i class="fas fa-eye me-1"></i>Переглянуто</span>
                    {% else %}
                        <span class="badge-gf badge-gf-success"><i class="fas fa-check me-1"></i>Вирішено</span>
                    {% endif %}
                </span>
                <small style="color:var(--gf-muted)">{{ report.createdAt|date('d.m.Y H:i') }}</small>
            </div>
            <small style="color:var(--gf-muted)">#{{ report.id }}</small>
        </div>

        <div class="row mb-2">
            <div class="col-md-6">
                <small style="color:var(--gf-muted)">Скаржник:</small>
                <a href="{{ path('app_profile_public', {id: report.reporter.id}) }}" class="text-decoration-none" style="color:var(--gf-text)">
                    <strong>{{ report.reporter.username }}</strong>
                </a>
            </div>
            <div class="col-md-6">
                {% if report.reportedUser %}
                    <small style="color:var(--gf-muted)">На кого:</small>
                    <a href="{{ path('app_profile_public', {id: report.reportedUser.id}) }}" class="text-decoration-none" style="color:var(--gf-text)">
                        <strong>{{ report.reportedUser.username }}</strong>
                    </a>
                    {% if report.reportedUser.isBanned %}
                        <span class="badge-gf badge-gf-danger ms-1">Заблоковано</span>
                    {% endif %}
                {% endif %}
            </div>
        </div>

        {% if report.reportedMessage %}
        <div class="mb-2 p-2" style="background:var(--gf-dark);border-radius:8px;">
            <small style="color:var(--gf-muted)"><i class="fas fa-comment me-1"></i>Повідомлення:</small>
            <p class="mb-0 mt-1">{{ report.reportedMessage.content }}</p>
        </div>
        {% endif %}

        {% if report.reportedReview %}
        <div class="mb-2 p-2" style="background:var(--gf-dark);border-radius:8px;">
            <small style="color:var(--gf-muted)"><i class="fas fa-star me-1"></i>Відгук:</small>
            <p class="mb-0 mt-1">{{ report.reportedReview.comment|default('(без коментаря)') }}</p>
        </div>
        {% endif %}

        <div class="mb-3 p-2" style="background:var(--gf-dark);border-radius:8px;">
            <small style="color:var(--gf-muted)">Причина:</small>
            <p class="mb-0 mt-1">{{ report.reason }}</p>
        </div>

        {% if report.moderatorNote %}
        <div class="mb-3 p-2" style="background:rgba(0,184,148,0.1);border-radius:8px;border:1px solid var(--gf-success);">
            <small style="color:var(--gf-success)"><i class="fas fa-gavel me-1"></i>Примітка модератора ({{ report.resolvedBy ? report.resolvedBy.username : '?' }}):</small>
            <p class="mb-0 mt-1">{{ report.moderatorNote }}</p>
        </div>
        {% endif %}

        {% if report.status == 'pending' %}
        <div class="d-flex gap-2 flex-wrap align-items-end">
            <form action="{{ path('app_moderator_report_resolve', {id: report.id}) }}" method="post" class="flex-fill">
                <div class="d-flex gap-2">
                    <input type="text" name="note" class="form-control form-control-sm" placeholder="Примітка модератора...">
                    <button type="submit" class="btn btn-gf-success btn-sm"><i class="fas fa-check me-1"></i>Вирішити</button>
                </div>
            </form>

            {% if report.reportedUser %}
                <form action="{{ path('app_moderator_ban', {id: report.reportedUser.id}) }}" method="post">
                    <input type="hidden" name="duration" value="24 години">
                    <button type="submit" class="btn btn-gf-danger btn-sm"><i class="fas fa-ban me-1"></i>Бан</button>
                </form>
            {% endif %}

            {% if report.reportedMessage %}
                <form action="{{ path('app_moderator_delete_message', {id: report.reportedMessage.id}) }}" method="post">
                    <button type="submit" class="btn btn-gf-danger btn-sm"><i class="fas fa-trash me-1"></i>Видалити повідомлення</button>
                </form>
            {% endif %}

            {% if report.reportedReview %}
                <form action="{{ path('app_moderator_delete_review', {id: report.reportedReview.id}) }}" method="post">
                    <button type="submit" class="btn btn-gf-danger btn-sm"><i class="fas fa-trash me-1"></i>Видалити відгук</button>
                </form>
            {% endif %}
        </div>
        {% endif %}
    </div>
    {% endfor %}
{% endif %}
{% endblock %}
