{% extends 'base.html.twig' %}

{% block title %}Чат - {{ event.title }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="fas fa-comments me-2" style="color:var(--gf-primary)"></i>{{ event.title }}</h4>
    <a href="{{ path('app_event_show', {id: event.id}) }}" class="btn btn-gf-outline btn-sm">
        <i class="fas fa-arrow-left me-1"></i> До події
    </a>
</div>

<div class="card-gf p-0">
    <div class="chat-container">
        <div class="chat-messages" id="chatMessages">
            {% for msg in messages %}
            <div class="chat-message {{ msg.sender.id == app.user.id ? 'own' : '' }}" data-id="{{ msg.id }}">
                {% if msg.sender.id != app.user.id %}
                <div>
                    {{ user_avatar(msg.sender.avatar, msg.sender.username, 'sm') }}
                </div>
                {% endif %}
                <div class="chat-bubble">
                    {% if msg.sender.id != app.user.id %}
                        <small style="color:var(--gf-primary);font-weight:600;">{{ msg.sender.username }}</small><br>
                    {% endif %}
                    {% if msg.type == 'voice' and msg.attachmentUrl %}
                        <audio controls preload="metadata" src="{{ msg.attachmentUrl }}" style="max-width:260px;"></audio>
                    {% else %}
                        {{ msg.content|render_stickers }}
                        {% if msg.attachmentUrl %}
                            <div class="mt-2">
                                {% if msg.type == 'image' %}
                                    <img src="{{ msg.attachmentUrl }}" style="max-width:200px;border-radius:8px;cursor:zoom-in;" alt="Зображення">
                                {% else %}
                                    <a href="{{ msg.attachmentUrl }}" class="glow-text" target="_blank"><i class="fas fa-file me-1"></i>Файл</a>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endif %}
                    <div class="mt-1 d-flex align-items-center gap-2">
                        <small style="color:var(--gf-muted);font-size:0.75rem;">{{ msg.createdAt|date('H:i') }}</small>
                        {% if msg.sender.id != app.user.id %}
                            <button class="btn btn-sm p-0 report-msg-btn" style="color:var(--gf-muted);font-size:0.65rem;background:none;border:none;opacity:0.5;" title="Поскаржитись" data-bs-toggle="modal" data-bs-target="#reportMsgModal" data-report-id="{{ msg.id }}">
                                <i class="fas fa-flag"></i>
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="chat-input">
            <div id="filePreview" style="display:none;padding:0.5rem 1rem;background:var(--gf-dark);border-bottom:1px solid var(--gf-border);">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-image" style="color:var(--gf-primary)"></i>
                    <span id="fileName" style="color:var(--gf-text);font-size:0.85rem;"></span>
                    <button type="button" id="fileClear" class="btn btn-sm" style="color:var(--gf-danger);padding:0;" aria-label="Видалити файл">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <form id="chatForm" class="d-flex gap-2 p-3 align-items-center" enctype="multipart/form-data" style="margin:0;">
                <input type="text" name="message" id="chatInput" class="form-control" placeholder="Написати повідомлення..." autocomplete="off">
                <button type="button" id="emojiBtn" class="btn btn-gf-outline" aria-label="Емодзі" title="Емодзі">
                    <i class="fas fa-face-smile"></i>
                </button>
                <label class="btn btn-gf-outline" style="cursor:pointer;" aria-label="Прикріпити файл" role="button">
                    <i class="fas fa-paperclip"></i>
                    <input type="file" name="attachment" id="fileInput" style="display:none;" accept="image/*,.doc,.docx" aria-label="Вибрати файл">
                </label>
                <button type="button" id="voiceBtn" class="btn btn-gf-outline" aria-label="Голосове повідомлення" title="Голосове повідомлення (макс. 60с)">
                    <i class="fas fa-microphone" id="voiceIcon"></i>
                    <span id="voiceTimer" class="ms-1" style="display:none;font-variant-numeric:tabular-nums;"></span>
                </button>
                <button type="submit" class="btn btn-gf" id="sendBtn" aria-label="Надіслати"><i class="fas fa-paper-plane"></i></button>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="reportMsgModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content" style="background:var(--gf-card);border:1px solid var(--gf-border);border-radius:16px;">
            <div class="modal-header" style="border-color:var(--gf-border);">
                <h6 class="modal-title" style="color:var(--gf-text)"><i class="fas fa-flag me-1" style="color:var(--gf-danger)"></i>Скарга на повідомлення</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрити"></button>
            </div>
            <form id="reportMsgForm" action="" method="post">
                <div class="modal-body">
                    <textarea name="reason" class="form-control form-control-sm" rows="2" placeholder="Причина скарги..." required></textarea>
                </div>
                <div class="modal-footer" style="border-color:var(--gf-border);">
                    <button type="submit" class="btn btn-gf-danger btn-sm"><i class="fas fa-paper-plane me-1"></i>Надіслати</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
    .chat-message:hover .report-msg-btn { opacity: 1 !important; }
    .report-msg-btn:hover { color: var(--gf-danger) !important; }
</style>
{% endblock %}

{% block javascripts %}
<script src="{{ asset('js/voice-recorder.js') }}"></script>
<script src="{{ asset('js/chat-attachment.js') }}"></script>
<script src="{{ asset('js/chat-lightbox.js') }}"></script>
<script src="{{ asset('js/emoji-picker.js') }}"></script>
<script>
const chatBox = document.getElementById('chatMessages');
const chatForm = document.getElementById('chatForm');
const chatInput = document.getElementById('chatInput');
const fileInput = document.getElementById('fileInput');
const filePreview = document.getElementById('filePreview');
const fileName = document.getElementById('fileName');
const fileClear = document.getElementById('fileClear');
const sendBtn = document.getElementById('sendBtn');
const currentUserId = {{ app.user.id }};
const sendUrl = '{{ path("app_event_chat_send", {id: event.id}) }}';
const pollUrl = '{{ path("app_event_chat_poll", {id: event.id}) }}';

function scrollToBottom() { chatBox.scrollTop = chatBox.scrollHeight; }
scrollToBottom();

const stickerData = {{ allStickers|json_encode|raw }};
function renderContentWithStickers(content) {
    return content.replace(/\[sticker:([a-z_]+)\]/g, (match, code) => {
        const s = stickerData[code];
        if (!s) return match;
        return `<div class="chat-sticker" title="${s.label}"><div class="chat-sticker-inner" style="background:linear-gradient(135deg,${s.color1},${s.color2});"><i class="fas ${s.icon}"></i></div></div>`;
    });
}

function getLastMessageId() {
    const msgs = chatBox.querySelectorAll('.chat-message[data-id]');
    if (msgs.length === 0) return 0;
    return parseInt(msgs[msgs.length - 1].dataset.id) || 0;
}

function renderMessage(msg) {
    const isOwn = msg.senderId === currentUserId;
    if (chatBox.querySelector(`[data-id="${msg.id}"]`)) return;

    const letter = msg.senderName.charAt(0).toUpperCase();
    let avatarHtml = `<div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#6c5ce7,#a855f7);display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.9rem;border:2px solid #6c5ce7;flex-shrink:0;">${letter}</div>`;

    let body;
    if (msg.type === 'voice' && msg.attachmentUrl) {
        body = renderVoiceBubble(msg.attachmentUrl);
    } else {
        body = renderContentWithStickers(msg.content);
        if (msg.attachmentUrl) {
            if (msg.type === 'image') {
                body += `<div class="mt-2"><img src="${msg.attachmentUrl}" style="max-width:200px;border-radius:8px;cursor:zoom-in;" alt="Зображення"></div>`;
            } else {
                body += `<div class="mt-2"><a href="${msg.attachmentUrl}" class="glow-text" target="_blank"><i class="fas fa-file me-1"></i>Файл</a></div>`;
            }
        }
    }

    let timeStr = msg.createdAt;
    if (timeStr.includes('T')) {
        const d = new Date(timeStr);
        timeStr = d.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
    }

    const reportBtn = !isOwn ? `<button class="btn btn-sm p-0 report-msg-btn" style="color:var(--gf-muted);font-size:0.65rem;background:none;border:none;opacity:0.5;" title="Поскаржитись" data-bs-toggle="modal" data-bs-target="#reportMsgModal" data-report-id="${msg.id}"><i class="fas fa-flag"></i></button>` : '';

    const html = `
        <div class="chat-message ${isOwn ? 'own' : ''}" data-id="${msg.id}">
            ${!isOwn ? `<div>${avatarHtml}</div>` : ''}
            <div class="chat-bubble">
                ${!isOwn ? `<small style="color:var(--gf-primary);font-weight:600;">${msg.senderName}</small><br>` : ''}
                ${body}
                <div class="mt-1 d-flex align-items-center gap-2"><small style="color:var(--gf-muted);font-size:0.75rem;">${timeStr}</small>${reportBtn}</div>
            </div>
        </div>`;
    chatBox.insertAdjacentHTML('beforeend', html);
    scrollToBottom();
}

fileInput.addEventListener('change', () => {
    if (fileInput.files.length === 0) return;
    if (!validateFile(fileInput.files[0])) {
        fileInput.value = '';
        filePreview.style.display = 'none';
        return;
    }
    fileName.textContent = fileInput.files[0].name;
    filePreview.style.display = 'block';
});

fileClear.addEventListener('click', () => {
    fileInput.value = '';
    filePreview.style.display = 'none';
});

chatForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = chatInput.value.trim();
    const hasFile = fileInput.files.length > 0;
    if (!msg && !hasFile) return;

    if (hasFile && !validateFile(fileInput.files[0])) {
        fileInput.value = '';
        filePreview.style.display = 'none';
        return;
    }

    const formData = new FormData(chatForm);
    sendBtn.disabled = true;
    sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    chatInput.value = '';
    filePreview.style.display = 'none';

    try {
        const res = await fetch(sendUrl, { method: 'POST', body: formData, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await res.json();
        if (data.message) {
            renderMessage(data.message);
        } else if (data.status === 'error') {
            alert(data.message || 'Не вдалося надіслати повідомлення');
        }
    } catch (err) {}

    sendBtn.disabled = false;
    sendBtn.innerHTML = '<i class="fas fa-paper-plane"></i>';
    fileInput.value = '';
    chatInput.focus();
});

setInterval(async () => {
    try {
        const res = await fetch(`${pollUrl}?after=${getLastMessageId()}`);
        const data = await res.json();
        if (data.messages) data.messages.forEach(renderMessage);
    } catch (err) {}
}, 2000);

chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); chatForm.dispatchEvent(new Event('submit')); }
});

initVoiceRecorder({ sendUrl: sendUrl, onMessage: renderMessage });

initEmojiPicker({
    buttonId: 'emojiBtn',
    inputId: 'chatInput',
    isPremium: {{ app.user.isPremium ? 'true' : 'false' }},
    emojis: {{ emojis|json_encode|raw }}
});

document.getElementById('reportMsgModal').addEventListener('show.bs.modal', (e) => {
    const msgId = e.relatedTarget.dataset.reportId;
    document.getElementById('reportMsgForm').action = '/report/message/' + msgId;
    document.querySelector('#reportMsgForm textarea').value = '';
});
</script>
{% endblock %}
