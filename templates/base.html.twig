<!DOCTYPE html>
<html lang="uk" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="GameFinder — вебплатформа для пошуку та підбору партнерів у багатокористувацьких онлайн-іграх.">
    <title>{% block title %}GameFinder{% endblock %} | GameFinder</title>
    <script>
        (function() {
            try {
                var saved = localStorage.getItem('gf-theme');
                if (saved === 'light' || saved === 'dark') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            } catch (e) {}
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='75' fill='%236c5ce7'>🎮</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        :root, [data-theme="dark"] {
            --gf-primary: #6c5ce7;
            --gf-secondary: #00cec9;
            --gf-dark: #0a0a1a;
            --gf-darker: #060612;
            --gf-card: #12122a;
            --gf-border: #1e1e3a;
            --gf-text: #e0e0ff;
            --gf-muted: #9999bb;
            --gf-success: #00b894;
            --gf-danger: #ff6b6b;
            --gf-warning: #fdcb6e;
            --gf-input-bg: #0d0d25;
            --gf-input-border: #2a2a4a;
            --gf-navbar-bg: linear-gradient(135deg, #0a0a1a 0%, #0d0d2b 100%);
            --gf-dropdown-bg: #12122a;
        }

        [data-theme="light"] {
            --gf-primary: #6c5ce7;
            --gf-secondary: #0984e3;
            --gf-dark: #f0f0f5;
            --gf-darker: #e8e8f0;
            --gf-card: #ffffff;
            --gf-border: #d0d0e0;
            --gf-text: #1a1a2e;
            --gf-muted: #666688;
            --gf-success: #00b894;
            --gf-danger: #d63031;
            --gf-warning: #e17055;
            --gf-input-bg: #ffffff;
            --gf-input-border: #c0c0d8;
            --gf-navbar-bg: linear-gradient(135deg, #ffffff 0%, #f0f0ff 100%);
            --gf-dropdown-bg: #ffffff;
        }

        body {
            background: var(--gf-darker);
            color: var(--gf-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .navbar-gf {
            background: var(--gf-navbar-bg);
            border-bottom: 1px solid var(--gf-border);
            padding: 0.75rem 0;
        }

        .navbar-gf .navbar-brand {
            color: var(--gf-secondary);
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: 1px;
        }

        .navbar-gf .nav-link {
            color: var(--gf-muted);
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .navbar-gf .nav-link:hover { color: var(--gf-text); background: rgba(108, 92, 231, 0.15); }

        [data-theme="light"] .navbar-toggler i { color: var(--gf-text) !important; }
        [data-theme="light"] .dropdown-item { color: var(--gf-text) !important; }
        [data-theme="light"] .dropdown-item:hover,
        [data-theme="light"] .dropdown-item:focus {
            background: rgba(108, 92, 231, 0.12);
            color: var(--gf-text) !important;
        }
        [data-theme="light"] .dropdown-item.text-danger { color: var(--gf-danger) !important; }
        [data-theme="light"] .dropdown-item.text-warning { color: #b45309 !important; }
        [data-theme="light"] footer { color: var(--gf-muted); }

        .btn-gf {
            background: linear-gradient(135deg, var(--gf-primary), #a855f7);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
        }
        .btn-gf:hover { filter: brightness(1.1); color: #fff; }

        .btn-gf-success {
            background: var(--gf-success);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
        }
        .btn-gf-success:hover { filter: brightness(1.1); color: #fff; }

        .btn-gf-danger {
            background: var(--gf-danger);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
        }
        .btn-gf-danger:hover { filter: brightness(1.1); color: #fff; }

        .card-gf {
            background: var(--gf-card);
            border: 1px solid var(--gf-border);
            border-radius: 16px;
            padding: 1.5rem;
        }

        .btn-gf-outline {
            background: transparent;
            color: var(--gf-text);
            border: 1px solid var(--gf-primary);
            border-radius: 10px;
            padding: 0.5rem 1.25rem;
            font-weight: 600;
        }
        .btn-gf-outline:hover { background: rgba(108, 92, 231, 0.15); color: var(--gf-text); }

        .form-control {
            background: var(--gf-input-bg);
            border: 2px solid var(--gf-input-border);
            color: var(--gf-text);
            border-radius: 10px;
            padding: 0.75rem 1rem;
        }
        textarea.form-control {
            background: var(--gf-input-bg);
            border: 2px solid var(--gf-input-border);
            color: var(--gf-text);
        }
        .form-control:focus, textarea.form-control:focus {
            background: var(--gf-input-bg);
            color: var(--gf-text);
            border-color: var(--gf-primary);
            box-shadow: 0 0 0 0.2rem rgba(108, 92, 231, 0.15);
        }
        .form-control::placeholder, textarea.form-control::placeholder { color: var(--gf-muted); opacity: 0.8; }

        .avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--gf-primary);
        }

        .avatar-md {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--gf-primary);
        }

        .avatar-lg {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--gf-primary);
        }

        .avatar-placeholder {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--gf-primary), #a855f7);
            color: #fff;
            font-weight: 700;
        }

        .notification-badge {
            position: absolute;
            top: 0;
            right: 0;
            background: var(--gf-danger);
            color: #fff;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .chat-container {
            height: calc(100vh - 250px);
            display: flex;
            flex-direction: column;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }

        .chat-message {
            margin-bottom: 1rem;
            display: flex;
            gap: 0.75rem;
        }

        .chat-message.own { flex-direction: row-reverse; }

        .chat-bubble {
            background: var(--gf-dark);
            border: 1px solid var(--gf-border);
            border-radius: 16px;
            padding: 0.75rem 1rem;
            max-width: 70%;
        }

        .chat-message.own .chat-bubble {
            background: rgba(108, 92, 231, 0.2);
            border-color: var(--gf-primary);
        }

        .chat-input {
            padding: 1rem;
            border-top: 1px solid var(--gf-border);
            background: var(--gf-dark);
            border-radius: 0 0 16px 16px;
        }

        footer {
            background: var(--gf-dark);
            border-top: 1px solid var(--gf-border);
            padding: 2rem 0;
            margin-top: 3rem;
            color: var(--gf-muted);
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-gf sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="fas fa-gamepad me-2"></i>GameFinder
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <i class="fas fa-bars text-white"></i>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            {% if app.user %}
                <ul class="navbar-nav me-auto" id="gf-nav-links">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_find_players') }}"><i class="fas fa-magic me-1"></i> Підбір</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_events') }}"><i class="fas fa-calendar me-1"></i> Події</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_leaderboard') }}"><i class="fas fa-ranking-star me-1"></i> Рейтинг</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_lobbies') }}"><i class="fas fa-door-open me-1"></i> Лобі</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_games') }}"><i class="fas fa-trophy me-1"></i> Ігри</a>
                    </li>
                </ul>

                <ul class="navbar-nav" id="gf-nav-actions">
                    <li class="nav-item">
                        <button type="button" id="gf-theme-toggle" class="nav-link btn btn-link" aria-label="Перемкнути тему" style="border:none;background:transparent;">
                            <i class="fas fa-moon" id="gf-theme-icon"></i>
                        </button>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_messages') }}" aria-label="Повідомлення"><i class="fas fa-envelope"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_friends') }}" aria-label="Друзі"><i class="fas fa-user-group"></i></a>
                    </li>
                    <li class="nav-item position-relative">
                        <a class="nav-link" href="{{ path('app_notifications') }}" aria-label="Сповіщення">
                            <i class="fas fa-bell"></i>
                            <span id="notif-badge" class="notification-badge" style="display:none;"></span>
                        </a>
                    </li>
                    <li class="nav-item dropdown" id="gf-nav-profile">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
                            {{ user_avatar(app.user.avatar, app.user.username, 'sm') }}
                            <span class="ms-2">{{ app.user.username }}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" style="background:var(--gf-dropdown-bg);border-color:var(--gf-border);">
                            <li><a class="dropdown-item text-light" href="{{ path('app_profile') }}"><i class="fas fa-user me-2"></i>Профіль</a></li>
                            <li><a class="dropdown-item text-light" href="{{ path('app_profile_edit') }}"><i class="fas fa-gear me-2"></i>Налаштування</a></li>
                            {% if is_granted('ROLE_MODERATOR') %}
                                <li><hr class="dropdown-divider" style="border-color:var(--gf-border)"></li>
                                <li><a class="dropdown-item" style="color:var(--gf-secondary)" href="{{ path('app_moderator') }}"><i class="fas fa-gavel me-2"></i>Модерація</a></li>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <li><hr class="dropdown-divider" style="border-color:var(--gf-border)"></li>
                                <li><a class="dropdown-item text-warning" href="{{ path('app_admin') }}"><i class="fas fa-shield me-2"></i>Адмінка</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider" style="border-color:var(--gf-border)"></li>
                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="fas fa-sign-out me-2"></i>Вийти</a></li>
                        </ul>
                    </li>
                </ul>
            {% else %}
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <button type="button" id="gf-theme-toggle" class="nav-link btn btn-link" aria-label="Перемкнути тему" style="border:none;background:transparent;">
                            <i class="fas fa-moon" id="gf-theme-icon"></i>
                        </button>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Вхід</a></li>
                    <li class="nav-item"><a class="btn btn-gf ms-2" href="{{ path('app_register') }}">Реєстрація</a></li>
                </ul>
            {% endif %}
        </div>
    </div>
</nav>

<main class="container py-4">
    {% block body %}{% endblock %}
</main>

<footer>
    <div class="container text-center">
        <p class="mb-1"><i class="fas fa-gamepad me-1"></i> GameFinder &copy; {{ "now"|date("Y") }}</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function() {
        const toggle = document.getElementById('gf-theme-toggle');
        const icon = document.getElementById('gf-theme-icon');
        if (!toggle || !icon) return;

        function applyIcon(theme) {
            icon.classList.toggle('fa-moon', theme === 'dark');
            icon.classList.toggle('fa-sun', theme === 'light');
        }

        applyIcon(document.documentElement.getAttribute('data-theme') || 'dark');

        toggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('gf-theme', next); } catch (e) {}
            applyIcon(next);
        });
    })();
</script>
<script>
    {% if app.user %}
    setInterval(async () => {
        try {
            const res = await fetch('{{ path("app_notifications_count") }}');
            const data = await res.json();
            const badge = document.getElementById('notif-badge');
            if (data.count > 0) {
                badge.textContent = data.count;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        } catch(e) {}
    }, 30000);
    {% endif %}
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
