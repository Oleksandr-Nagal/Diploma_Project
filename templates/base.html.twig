<!DOCTYPE html>
<html lang="uk" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="GameFinder — вебплатформа для пошуку та підбору партнерів у багатокористувацьких онлайн-іграх.">
    <title>{% block title %}GameFinder{% endblock %} | GameFinder</title>
    <script>
        (function() {
            try {
                var saved = localStorage.getItem('gf-theme');
                if (saved === 'light' || saved === 'dark') {
                    document.documentElement.setAttribute('data-theme', saved);
                }
            } catch (e) {}
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='75' font-size='75' fill='%236c5ce7'>🎮</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <style>
        :root, [data-theme="dark"] {
            --gf-primary: #6c5ce7;
            --gf-secondary: #00cec9;
            --gf-dark: #0a0a1a;
            --gf-darker: #060612;
            --gf-card: #12122a;
            --gf-border: #1e1e3a;
            --gf-text: #e0e0ff;
            --gf-muted: #9999bb;
            --gf-success: #00b894;
            --gf-danger: #ff6b6b;
            --gf-warning: #fdcb6e;
            --gf-input-bg: #0d0d25;
            --gf-input-border: #2a2a4a;
            --gf-navbar-bg: linear-gradient(135deg, #0a0a1a 0%, #0d0d2b 100%);
            --gf-dropdown-bg: #12122a;
        }

        [data-theme="light"] {
            --gf-primary: #6c5ce7;
            --gf-secondary: #0984e3;
            --gf-dark: #f0f0f5;
            --gf-darker: #e8e8f0;
            --gf-card: #ffffff;
            --gf-border: #d0d0e0;
            --gf-text: #1a1a2e;
            --gf-muted: #666688;
            --gf-success: #00b894;
            --gf-danger: #d63031;
            --gf-warning: #e17055;
            --gf-input-bg: #ffffff;
            --gf-input-border: #c0c0d8;
            --gf-navbar-bg: linear-gradient(135deg, #ffffff 0%, #f0f0ff 100%);
            --gf-dropdown-bg: #ffffff;
        }

        body {
            background: var(--gf-darker);
            color: var(--gf-text);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-gf {
            background: var(--gf-navbar-bg);
            border-bottom: 1px solid var(--gf-border);
            padding: 0.75rem 0;
        }

        .navbar-gf .navbar-brand {
            color: var(--gf-secondary);
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: 1px;
        }

        .navbar-gf .nav-link {
            color: var(--gf-muted);
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .navbar-gf .nav-link:hover { color: var(--gf-text); background: rgba(108, 92, 231, 0.15); }

        [data-theme="light"] .navbar-toggler i { color: var(--gf-text) !important; }
        [data-theme="light"] .dropdown-item { color: var(--gf-text) !important; }
        [data-theme="light"] .dropdown-item:hover,
        [data-theme="light"] .dropdown-item:focus {
            background: rgba(108, 92, 231, 0.12);
            color: var(--gf-text) !important;
        }
        [data-theme="light"] .dropdown-item.text-danger { color: var(--gf-danger) !important; }
        [data-theme="light"] .dropdown-item.text-warning { color: #b45309 !important; }
        [data-theme="light"] footer { color: var(--gf-muted); }

        .btn-gf {
            background: linear-gradient(135deg, var(--gf-primary), #a855f7);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
            transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
        }
        .btn-gf:hover { transform: scale(1.03); filter: brightness(1.1); box-shadow: 0 4px 16px rgba(108, 92, 231, 0.3); color: #fff; }
        .btn-gf:active { transform: scale(0.97); }

        .btn-gf-success {
            background: var(--gf-success);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
        }
        .btn-gf-success:hover { filter: brightness(1.1); color: #fff; }

        .btn-gf-danger {
            background: var(--gf-danger);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 0.5rem 1.5rem;
            font-weight: 600;
        }
        .btn-gf-danger:hover { filter: brightness(1.1); color: #fff; }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .empty-state-icon {
            display: inline-block;
            animation: emptyFloat 3s ease-in-out infinite;
            color: var(--gf-muted);
            opacity: 0.6;
        }

        @keyframes emptyFloat {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .card-gf {
            background: var(--gf-card);
            border: 1px solid var(--gf-border);
            border-radius: 16px;
            padding: 1.5rem;
            opacity: 0;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .card-gf:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(108, 92, 231, 0.15);
        }

        .card-gf-visible {
            animation: fadeInUp 0.4s ease forwards;
        }

        .badge-gf {
            display: inline-block;
            background: rgba(108, 92, 231, 0.15);
            color: var(--gf-text);
            border: 1px solid rgba(108, 92, 231, 0.3);
            border-radius: 20px;
            padding: 0.3rem 0.75rem;
            font-size: 0.8rem;
            font-weight: 500;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .badge-gf:hover {
            transform: scale(1.05);
            box-shadow: 0 2px 8px rgba(108, 92, 231, 0.2);
        }
        .badge-gf-success {
            background: rgba(0, 184, 148, 0.15);
            border-color: rgba(0, 184, 148, 0.3);
            color: var(--gf-success);
        }
        .badge-gf-warning {
            background: rgba(253, 203, 110, 0.15);
            border-color: rgba(253, 203, 110, 0.3);
            color: var(--gf-warning);
        }
        .badge-gf-danger {
            background: rgba(255, 107, 107, 0.15);
            border-color: rgba(255, 107, 107, 0.3);
            color: var(--gf-danger);
        }

        .btn-gf-outline {
            background: transparent;
            color: var(--gf-text);
            border: 1px solid var(--gf-primary);
            border-radius: 10px;
            padding: 0.5rem 1.25rem;
            font-weight: 600;
        }
        .btn-gf-outline:hover { background: rgba(108, 92, 231, 0.15); color: var(--gf-text); }

        .form-control {
            background: var(--gf-input-bg);
            border: 2px solid var(--gf-input-border);
            color: var(--gf-text);
            border-radius: 10px;
            padding: 0.75rem 1rem;
        }
        textarea.form-control {
            background: var(--gf-input-bg);
            border: 2px solid var(--gf-input-border);
            color: var(--gf-text);
        }
        .form-control:focus, textarea.form-control:focus {
            background: var(--gf-input-bg);
            color: var(--gf-text);
            border-color: var(--gf-primary);
            box-shadow: 0 0 0 0.2rem rgba(108, 92, 231, 0.15);
        }
        .form-control::placeholder, textarea.form-control::placeholder { color: var(--gf-muted); opacity: 0.8; }
        .form-control::-webkit-calendar-picker-indicator {
            filter: invert(0.7) sepia(1) saturate(2) hue-rotate(210deg);
            cursor: pointer;
        }
        [data-theme="light"] .form-control::-webkit-calendar-picker-indicator {
            filter: none;
        }

        .form-select {
            background-color: var(--gf-input-bg);
            border: 2px solid var(--gf-input-border);
            color: var(--gf-text);
            border-radius: 10px;
            padding: 0.75rem 1rem;
        }
        .form-select:focus {
            background-color: var(--gf-input-bg);
            color: var(--gf-text);
            border-color: var(--gf-primary);
            box-shadow: 0 0 0 0.2rem rgba(108, 92, 231, 0.15);
        }
        .form-select option {
            background-color: var(--gf-card);
            color: var(--gf-text);
        }

        .avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--gf-primary);
        }

        .avatar-md {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--gf-primary);
        }

        .avatar-lg {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--gf-primary);
        }

        .avatar-placeholder {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--gf-primary), #a855f7);
            color: #fff;
            font-weight: 700;
        }

        .premium-avatar {
            border: 3px solid transparent !important;
            background-clip: padding-box !important;
            position: relative;
        }
        .premium-avatar::before {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f39c12, #e74c3c, #6c5ce7, #00cec9, #f39c12);
            background-size: 300% 300%;
            animation: premium-glow 3s ease infinite;
            z-index: -1;
        }
        @keyframes premium-glow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        img.premium-avatar {
            position: relative;
        }
        div.premium-avatar {
            position: relative;
            border: none !important;
        }

        .notification-badge {
            position: absolute;
            top: 0;
            right: 0;
            background: var(--gf-danger);
            color: #fff;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .emoji-picker {
            position: absolute;
            bottom: 100%;
            right: 0;
            background: var(--gf-card);
            border: 1px solid var(--gf-border);
            border-radius: 12px;
            padding: 0.75rem;
            width: 280px;
            max-height: 250px;
            overflow-y: auto;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }
        .emoji-picker-section {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }
        .emoji-item {
            font-size: 1.4rem;
            cursor: pointer;
            padding: 4px;
            border-radius: 6px;
            transition: background 0.15s;
            line-height: 1;
        }
        .emoji-item:hover {
            background: rgba(108, 92, 231, 0.2);
        }
        .emoji-picker-divider {
            border-top: 1px solid var(--gf-border);
            margin: 0.5rem 0;
            padding-top: 0.5rem;
            font-size: 0.75rem;
            color: var(--gf-primary);
            font-weight: 600;
        }
        .sticker-grid {
            display: grid !important;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
        }
        .sticker-item {
            cursor: pointer;
            border-radius: 8px;
            transition: transform 0.15s;
        }
        .sticker-item:hover {
            transform: scale(1.15);
        }
        .sticker-preview {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .sticker-preview i {
            font-size: 1.4rem;
            color: #fff;
        }
        .chat-sticker {
            display: inline-block;
            margin: 4px 0;
        }
        .chat-sticker-inner {
            width: 64px;
            height: 64px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: sticker-bounce 0.5s ease;
        }
        .chat-sticker-inner i {
            font-size: 2rem;
            color: #fff;
            animation: sticker-pulse 2s ease-in-out infinite;
        }
        @keyframes sticker-bounce {
            0% { transform: scale(0.3); opacity: 0; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }
        @keyframes sticker-pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .chat-container {
            height: calc(100vh - 250px);
            display: flex;
            flex-direction: column;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }

        .chat-message {
            margin-bottom: 1rem;
            display: flex;
            gap: 0.75rem;
        }

        .chat-message.own { flex-direction: row-reverse; }

        .chat-bubble {
            background: var(--gf-dark);
            border: 1px solid var(--gf-border);
            border-radius: 16px;
            padding: 0.75rem 1rem;
            max-width: 70%;
        }

        .chat-message.own .chat-bubble {
            background: rgba(108, 92, 231, 0.2);
            border-color: var(--gf-primary);
        }

        .chat-input {
            padding: 1rem;
            border-top: 1px solid var(--gf-border);
            background: var(--gf-dark);
            border-radius: 0 0 16px 16px;
        }

        footer {
            background: var(--gf-dark);
            border-top: 1px solid var(--gf-border);
            padding: 2rem 0;
            margin-top: 3rem;
            color: var(--gf-muted);
        }

        .gf-toast-container {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .gf-toast {
            padding: 0.85rem 1.25rem;
            border-radius: 12px;
            color: #fff;
            font-weight: 500;
            font-size: 0.9rem;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            gap: 0.6rem;
            animation: toastIn 0.35s ease forwards;
            max-width: 360px;
        }

        .gf-toast-success { background: linear-gradient(135deg, #00b894, #00a381); }
        .gf-toast-error { background: linear-gradient(135deg, #ff6b6b, #d63031); }
        .gf-toast-info { background: linear-gradient(135deg, var(--gf-primary), #a855f7); }

        .gf-toast-hide {
            animation: toastOut 0.3s ease forwards;
        }

        @keyframes toastIn {
            from { opacity: 0; transform: translateX(40px); }
            to { opacity: 1; transform: translateX(0); }
        }

        @keyframes toastOut {
            from { opacity: 1; transform: translateX(0); }
            to { opacity: 0; transform: translateX(40px); }
        }
    </style>
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.min.css" rel="stylesheet">
    <style>
        .ts-wrapper {
            background: transparent !important;
            border: none !important;
            padding: 0 !important;
        }
        .ts-wrapper .ts-control {
            background: var(--gf-input-bg) !important;
            color: var(--gf-text) !important;
            border: 2px solid var(--gf-input-border) !important;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            min-height: 46px;
            box-shadow: none !important;
        }
        .ts-wrapper .ts-control input {
            background: transparent !important;
            color: var(--gf-text) !important;
        }
        .ts-wrapper .ts-control input::placeholder { color: var(--gf-muted); opacity: 0.8; }
        .ts-wrapper .ts-control .item { color: var(--gf-text); background: transparent; }
        .ts-wrapper.focus .ts-control {
            border-color: var(--gf-primary) !important;
            box-shadow: 0 0 0 0.2rem rgba(108, 92, 231, 0.15) !important;
        }
        .ts-dropdown,
        .ts-dropdown .ts-dropdown-content {
            background: var(--gf-card) !important;
            border: 2px solid var(--gf-input-border) !important;
            border-radius: 10px;
            color: var(--gf-text);
        }
        .ts-dropdown .option { color: var(--gf-text); padding: 0.5rem 1rem; }
        .ts-dropdown .option.active,
        .ts-dropdown .option:hover { background: rgba(108, 92, 231, 0.2); color: var(--gf-text); }
        .ts-wrapper.single .ts-control::after { border-color: var(--gf-muted) transparent transparent transparent; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-gf sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/">
            <i class="fas fa-gamepad me-2"></i>GameFinder
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <i class="fas fa-bars text-white"></i>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            {% if app.user %}
                <ul class="navbar-nav me-auto" id="gf-nav-links">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_find_players') }}"><i class="fas fa-magic me-1"></i> Підбір</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_events') }}"><i class="fas fa-calendar me-1"></i> Події</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_leaderboard') }}"><i class="fas fa-ranking-star me-1"></i> Рейтинг</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_lobbies') }}"><i class="fas fa-door-open me-1"></i> Лобі</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_games') }}"><i class="fas fa-trophy me-1"></i> Ігри</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_premium') }}"><i class="fas fa-crown me-1"></i> Premium</a>
                    </li>
                </ul>

                <ul class="navbar-nav" id="gf-nav-actions">
                    <li class="nav-item">
                        <button type="button" id="gf-theme-toggle" class="nav-link btn btn-link" aria-label="Перемкнути тему" style="border:none;background:transparent;">
                            <i class="fas fa-moon" id="gf-theme-icon"></i>
                        </button>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_messages') }}" aria-label="Повідомлення"><i class="fas fa-envelope"></i></a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_friends') }}" aria-label="Друзі"><i class="fas fa-user-group"></i></a>
                    </li>
                    <li class="nav-item position-relative">
                        <a class="nav-link" href="{{ path('app_notifications') }}" aria-label="Сповіщення">
                            <i class="fas fa-bell"></i>
                            <span id="notif-badge" class="notification-badge" style="display:none;"></span>
                        </a>
                    </li>
                    <li class="nav-item dropdown" id="gf-nav-profile">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
                            {{ user_avatar(app.user.avatar, app.user.username, 'sm', app.user.isPremium) }}
                            <span class="ms-2">{{ app.user.username }}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" style="background:var(--gf-dropdown-bg);border-color:var(--gf-border);">
                            <li><a class="dropdown-item text-light" href="{{ path('app_profile') }}"><i class="fas fa-user me-2"></i>Профіль</a></li>
                            <li><a class="dropdown-item text-light" href="{{ path('app_profile_edit') }}"><i class="fas fa-gear me-2"></i>Налаштування</a></li>
                            {% if is_granted('ROLE_MODERATOR') %}
                                <li><hr class="dropdown-divider" style="border-color:var(--gf-border)"></li>
                                <li><a class="dropdown-item" style="color:var(--gf-secondary)" href="{{ path('app_moderator') }}"><i class="fas fa-gavel me-2"></i>Модерація</a></li>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <li><hr class="dropdown-divider" style="border-color:var(--gf-border)"></li>
                                <li><a class="dropdown-item text-warning" href="{{ path('app_admin') }}"><i class="fas fa-shield me-2"></i>Адмінка</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider" style="border-color:var(--gf-border)"></li>
                            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="fas fa-sign-out me-2"></i>Вийти</a></li>
                        </ul>
                    </li>
                </ul>
            {% else %}
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_lobbies') }}"><i class="fas fa-door-open me-1"></i> Лобі</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_events') }}"><i class="fas fa-calendar me-1"></i> Події</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_leaderboard') }}"><i class="fas fa-ranking-star me-1"></i> Рейтинг</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_games') }}"><i class="fas fa-trophy me-1"></i> Ігри</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <button type="button" id="gf-theme-toggle" class="nav-link btn btn-link" aria-label="Перемкнути тему" style="border:none;background:transparent;">
                            <i class="fas fa-moon" id="gf-theme-icon"></i>
                        </button>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}"><i class="fas fa-sign-in-alt me-1"></i> Увійти</a></li>
                    <li class="nav-item"><a class="btn btn-gf ms-2" href="{{ path('app_register') }}"><i class="fas fa-user-plus me-1"></i> Зареєструватись</a></li>
                </ul>
            {% endif %}
        </div>
    </div>
</nav>

<div class="gf-toast-container" id="gfToasts">
    {% for type in ['success', 'error', 'info'] %}
        {% for message in app.flashes(type) %}
            <div class="gf-toast gf-toast-{{ type }}">
                <i class="fas {{ type == 'success' ? 'fa-check-circle' : (type == 'error' ? 'fa-exclamation-circle' : 'fa-info-circle') }}"></i>
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
</div>

<main class="container py-4" style="flex:1">
    {% block body %}{% endblock %}
</main>

<footer>
    <div class="container text-center">
        <p class="mb-1"><i class="fas fa-gamepad me-1"></i> GameFinder &copy; {{ "now"|date("Y") }}</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    (function() {
        const toggle = document.getElementById('gf-theme-toggle');
        const icon = document.getElementById('gf-theme-icon');
        if (!toggle || !icon) return;

        function applyIcon(theme) {
            icon.classList.toggle('fa-moon', theme === 'dark');
            icon.classList.toggle('fa-sun', theme === 'light');
        }

        applyIcon(document.documentElement.getAttribute('data-theme') || 'dark');

        toggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('gf-theme', next); } catch (e) {}
            applyIcon(next);
        });
    })();
</script>
<script>
    {% if app.user %}
    setInterval(async () => {
        try {
            const res = await fetch('{{ path("app_notifications_count") }}');
            const data = await res.json();
            const badge = document.getElementById('notif-badge');
            if (data.count > 0) {
                badge.textContent = data.count;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        } catch(e) {}
    }, 30000);
    {% endif %}
</script>
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
<script>
    document.querySelectorAll('.tom-select-city').forEach(el => {
        new TomSelect(el, {
            create: false,
            sortField: { field: 'text', direction: 'asc' },
            placeholder: el.querySelector('option[value=""]')?.textContent || 'Оберіть місто',
            allowEmptyOption: true,
        });
    });
</script>
<script>
    (function() {
        try {
            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            if (tz && document.cookie.indexOf('user_timezone=' + tz) === -1) {
                document.cookie = "user_timezone=" + tz + "; path=/; max-age=31536000; SameSite=Lax";
            }
        } catch (e) {}
    })();
</script>
<script>
document.querySelectorAll('.card-gf').forEach((card, i) => {
    setTimeout(() => card.classList.add('card-gf-visible'), i * 100);
});

document.querySelectorAll('.gf-toast').forEach((toast, i) => {
    setTimeout(() => {
        toast.classList.add('gf-toast-hide');
        toast.addEventListener('animationend', () => toast.remove());
    }, 4000 + i * 300);
});
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
