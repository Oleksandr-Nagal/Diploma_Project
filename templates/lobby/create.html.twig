{% extends 'base.html.twig' %}

{% block title %}Створити лобі{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-header">
            <h1><i class="fas fa-plus-circle me-2" style="color:var(--gf-primary)"></i>Конструктор лобі</h1>
            <p style="color:var(--gf-muted)">Налаштуй кімнату під себе і знайди ідеальних тіммейтів</p>
        </div>

        <div class="card-gf">
            {{ form_start(form) }}
                {% for field in form %}
                    {% if field.vars.name != '_token' %}
                    <div class="mb-3">
                        {{ form_label(field) }}
                        {% set extra_class = field.vars.attr.class|default('') %}
                        {% if field.vars.block_prefixes[1] == 'checkbox' %}
                            <div>{{ form_widget(field) }}</div>
                        {% elseif field.vars.block_prefixes[1] == 'choice' or field.vars.block_prefixes[1] == 'entity' %}
                            {{ form_widget(field, {'attr': {'class': ('form-select ' ~ extra_class)|trim}}) }}
                        {% elseif field.vars.block_prefixes[1] == 'textarea' %}
                            {{ form_widget(field, {'attr': {'class': 'form-control'}}) }}
                        {% else %}
                            {{ form_widget(field, {'attr': {'class': 'form-control'}}) }}
                        {% endif %}
                        {{ form_errors(field) }}
                    </div>
                    {% endif %}
                {% endfor %}

                <button type="submit" class="btn btn-gf">
                    <i class="fas fa-rocket me-1"></i> Створити лобі
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    const scheduled = document.querySelector('input[name="lobby[scheduledAt]"]');
    if (!scheduled) return;

    const form = scheduled.closest('form');

    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    scheduled.min = now.toISOString().slice(0, 16);

    form.addEventListener('submit', (e) => {
        if (!scheduled.value) return;

        const val = new Date(scheduled.value);
        const nowCheck = new Date();

        if (val < nowCheck) {
            e.preventDefault();
            alert('Дата не може бути у минулому.');
            return;
        }
        if (val.getFullYear() > 2030) {
            e.preventDefault();
            alert('Рік не може перевищувати 2030.');
            return;
        }
    });
})();
</script>
{% endblock %}
