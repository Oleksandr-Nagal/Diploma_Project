{% extends 'base.html.twig' %}

{% block title %}{{ lobby.title }}{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <div class="card-gf mb-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2>{{ lobby.title }}</h2>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge-gf"><i class="fas fa-gamepad me-1"></i>{{ lobby.game.name }}</span>
                        <span class="badge-gf badge-gf-success"><i class="fas fa-users me-1"></i>{{ lobby.currentMemberCount }}/{{ lobby.maxMembers }}</span>
                        {% if lobby.skillLevel != 'any' %}<span class="badge-gf badge-gf-warning">{{ lobby.skillLevel }}</span>{% endif %}
                        {% if lobby.language %}<span class="badge-gf"><i class="fas fa-globe me-1"></i>{{ lobby.language }}</span>{% endif %}
                        {% if lobby.city %}<span class="badge-gf"><i class="fas fa-map-marker-alt me-1"></i>{{ lobby.city }}</span>{% endif %}
                        {% if lobby.voiceChat %}<span class="badge-gf" style="color:var(--gf-secondary)"><i class="fas fa-microphone me-1"></i>Голосовий чат</span>{% endif %}
                        {% if lobby.isPrivate %}<span class="badge-gf badge-gf-warning"><i class="fas fa-lock me-1"></i>Приватне</span>{% endif %}
                        {% if lobby.scheduledAt %}<span class="badge-gf badge-gf-warning"><i class="fas fa-clock me-1"></i>{{ lobby.scheduledAt|date('d.m.Y H:i') }}</span>{% endif %}
                    </div>
                </div>
                <span class="badge-gf {{ lobby.status == 'open' ? 'badge-gf-success' : 'badge-gf-danger' }}">
                    {{ lobby.status }}
                </span>
            </div>

            {% if lobby.description %}
                <p style="color:var(--gf-muted)">{{ lobby.description }}</p>
            {% endif %}

            {% if lobby.minAge or lobby.maxAge %}
                <p style="color:var(--gf-muted)">
                    <i class="fas fa-birthday-cake me-1"></i> Вік:
                    {% if lobby.minAge %}від {{ lobby.minAge }}{% endif %}
                    {% if lobby.maxAge %}до {{ lobby.maxAge }}{% endif %}
                </p>
            {% endif %}

            <div class="mt-3 d-flex gap-2">
                {% if not isMember and not isOwner and not isPending and lobby.status == 'open' %}
                    <form action="{{ path('app_lobby_join', {id: lobby.id}) }}" method="post">
                        <button class="btn btn-gf"><i class="fas fa-sign-in-alt me-1"></i> Приєднатися</button>
                    </form>
                {% endif %}

                {% if isPending %}
                    <button class="btn btn-gf-outline" disabled>
                        <i class="fas fa-clock me-1"></i> Заявку надіслано, очікуйте...
                    </button>
                {% endif %}

                {% if isMember or isOwner %}
                    <a href="{{ path('app_lobby_chat', {id: lobby.id}) }}" class="btn btn-gf-outline">
                        <i class="fas fa-comments me-1"></i> Чат кімнати
                    </a>
                {% endif %}

                {% if isMember and not isOwner %}
                    <form action="{{ path('app_lobby_leave', {id: lobby.id}) }}" method="post">
                        <button class="btn btn-gf-danger"><i class="fas fa-sign-out me-1"></i> Покинути</button>
                    </form>
                {% endif %}

                {% if isOwner and lobby.status != 'closed' %}
                    <form action="{{ path('app_lobby_close', {id: lobby.id}) }}" method="post" onsubmit="return confirm('Закрити лобі? Цю дію не можна скасувати.')">
                        <button class="btn btn-gf-danger"><i class="fas fa-lock me-1"></i> Закрити кімнату</button>
                    </form>
                {% endif %}

                {% if is_granted('ROLE_MODERATOR') and not isOwner and lobby.status != 'closed' %}
                    <form action="{{ path('app_moderator_close_lobby', {id: lobby.id}) }}" method="post" onsubmit="return confirm('[Модерація] Ви впевнені, що хочете примусово закрити це лобі?')">
                        <button class="btn btn-gf-danger"><i class="fas fa-gavel me-1"></i> Закрити лобі (Модератор)</button>
                    </form>
                {% endif %}

                {% if not isOwner %}
                    <button class="btn btn-sm" style="color:var(--gf-danger);background:transparent;border:1px solid var(--gf-danger);border-radius:8px;font-weight:600;" type="button" data-bs-toggle="modal" data-bs-target="#reportLobbyOwner">
                        <i class="fas fa-flag me-1"></i> Скарга
                    </button>
                {% endif %}
            </div>
        </div>

    </div>

    <div class="col-lg-4">
        <div class="card-gf mb-4">
            <h5 class="mb-3"><i class="fas fa-users me-2" style="color:var(--gf-secondary)"></i>Учасники</h5>

            {% for member in lobby.members %}
                {% if member.status == 'accepted' %}
                <div class="d-flex align-items-center gap-2 mb-2 p-2" style="background:var(--gf-dark);border-radius:10px;">
                    {{ user_avatar(member.user.avatar, member.user.username, 'sm', member.user.isPremium) }}
                    <div class="flex-fill">
                        <a href="{{ path('app_profile_public', {id: member.user.id}) }}" class="text-decoration-none" style="color:var(--gf-text)">
                            {{ member.user.username }}
                        </a>
                        {% if member.role == 'owner' %}
                            <span class="badge-gf-warning" style="font-size:0.7rem;padding:0.1rem 0.4rem;border-radius:8px;">Власник</span>
                        {% endif %}
                    </div>
                    <small style="color:var(--gf-muted)">{{ member.user.rating|round(0) }}%</small>
                </div>
                {% endif %}
            {% endfor %}
        </div>

        {% if isOwner %}
            {% set pendingMembers = lobby.members|filter(m => m.status == 'pending') %}
            {% if pendingMembers|length > 0 %}
            <div class="card-gf">
                <h5 class="mb-3"><i class="fas fa-clock me-2" style="color:var(--gf-warning)"></i>Заявки</h5>
                {% for member in pendingMembers %}
                <div class="d-flex align-items-center gap-2 mb-2 p-2" style="background:var(--gf-dark);border-radius:10px;">
                    <div class="flex-fill">
                        <a href="{{ path('app_profile_public', {id: member.user.id}) }}" class="text-decoration-none" style="color:var(--gf-text)">
                            {{ member.user.username }}
                        </a>
                        <br><small style="color:var(--gf-muted)">Рейтинг: {{ member.user.rating|round(0) }}%</small>
                    </div>
                    <form action="{{ path('app_lobby_accept', {id: lobby.id, memberId: member.id}) }}" method="post" class="d-inline">
                        <button class="btn btn-gf-success btn-sm" aria-label="Прийняти"><i class="fas fa-check"></i></button>
                    </form>
                    <form action="{{ path('app_lobby_reject', {id: lobby.id, memberId: member.id}) }}" method="post" class="d-inline">
                        <button class="btn btn-gf-danger btn-sm" aria-label="Відхилити"><i class="fas fa-times"></i></button>
                    </form>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        {% endif %}

        <div class="card-gf mt-4">
            <h5 class="mb-3">Власник лобі</h5>
            <div class="d-flex align-items-center gap-3">
                {{ user_avatar(lobby.owner.avatar, lobby.owner.username, 'md', lobby.owner.isPremium) }}
                <div>
                    <a href="{{ path('app_profile_public', {id: lobby.owner.id}) }}" class="text-decoration-none" style="color:var(--gf-text)">
                        <strong>{{ lobby.owner.username }}</strong>
                    </a>
                    <br><small style="color:var(--gf-muted)">Рейтинг: {{ lobby.owner.rating|round(0) }}%</small>
                </div>
            </div>
        </div>
    </div>
</div>

{% if not isOwner %}
<div class="modal fade" id="reportLobbyOwner" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content" style="background:var(--gf-card);border:1px solid var(--gf-border);border-radius:16px;">
            <div class="modal-header" style="border-color:var(--gf-border);">
                <h6 class="modal-title" style="color:var(--gf-text)"><i class="fas fa-flag me-1" style="color:var(--gf-danger)"></i>Скарга на лобі</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрити"></button>
            </div>
            <form action="{{ path('app_report_user', {id: lobby.owner.id}) }}" method="post">
                <div class="modal-body">
                    <textarea name="reason" class="form-control form-control-sm" rows="2" placeholder="Опишіть проблему..." required></textarea>
                </div>
                <div class="modal-footer" style="border-color:var(--gf-border);">
                    <button type="submit" class="btn btn-gf-danger btn-sm"><i class="fas fa-paper-plane me-1"></i>Надіслати</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% if isMember or isOwner %}
<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--gf-card);border:1px solid var(--gf-border);border-radius:16px;">
            <div class="modal-header" style="border-color:var(--gf-border);">
                <h5 class="modal-title" style="color:var(--gf-text)"><i class="fas fa-star text-warning me-2"></i>Оцініть союзників</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрити"></button>
            </div>
            <div class="modal-body" id="reviewModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Завантаження...</p>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between" style="border-color:var(--gf-border);">
                <button type="button" class="btn btn-gf-outline" data-bs-dismiss="modal">Пропустити</button>
                <button type="button" class="btn btn-gf" id="btnSubmitReviews">Зберегти відгуки</button>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
const statusUrl = '{{ path("app_lobby_status", {id: lobby.id}) }}';
const reviewDataUrl = '{{ path("api_lobby_review_data", {id: lobby.id}) }}';
const reviewSubmitUrl = '{{ path("api_reviews_batch_upsert") }}';
const lobbyId = {{ lobby.id }};
let currentStatus = '{{ isPending ? "pending" : (isMember ? "accepted" : (isOwner ? "owner" : "none")) }}';
const isParticipant = {{ (isMember or isOwner) ? 'true' : 'false' }};

let lobbyClosedHandled = false;
setInterval(async () => {
    try {
        const res = await fetch(statusUrl);
        const data = await res.json();

        if (data.lobbyStatus === 'closed' && !lobbyClosedHandled && isParticipant && reviewModalInstance) {
            lobbyClosedHandled = true;
            loadReviewData();
            reviewModalInstance.show();
            return;
        }

        if (data.memberStatus !== currentStatus && data.lobbyStatus !== 'closed') {
            window.location.reload();
            return;
        }
    } catch(e) {}
}, 3000);

let reviewModalInstance = null;

function renderReviewStars(targetId, savedPositive) {
    let positiveChecked = savedPositive === true ? 'checked' : '';
    let negativeChecked = savedPositive === false ? 'checked' : '';
    let noneChecked = savedPositive === null ? 'checked' : '';

    return `
        <div class="d-flex gap-3 mb-2">
            <div class="form-check">
                <input class="form-check-input review-radio" type="radio" name="rating_${targetId}" value="positive" ${positiveChecked}>
                <label class="form-check-label text-success"><i class="fas fa-thumbs-up"></i> Добре</label>
            </div>
            <div class="form-check">
                <input class="form-check-input review-radio" type="radio" name="rating_${targetId}" value="negative" ${negativeChecked}>
                <label class="form-check-label text-danger"><i class="fas fa-thumbs-down"></i> Погано</label>
            </div>
        </div>
    `;
}

async function loadReviewData() {
    try {
        const res = await fetch(reviewDataUrl);
        const data = await res.json();
        const body = document.getElementById('reviewModalBody');
        
        if (!data || data.length === 0) {
            body.innerHTML = '<p class="text-center text-muted my-3">Немає інших учасників для оцінювання.</p>';
            return;
        }

        let html = '<p style="color:var(--gf-muted);opacity:0.85;" class="mb-3">Ви можете оцінити гру з вашими союзниками. Це допоможе сформувати їхній рейтинг.</p>';
        data.forEach(user => {
            let avatarHtml = user.avatarHtml;
            
            let isPositive = user.existingReview ? user.existingReview.isPositive : null;
            let comment = user.existingReview ? (user.existingReview.comment || '') : '';
            let editBadge = user.existingReview ? `<span class="badge bg-info ms-2" style="font-size:0.7rem">Ви вже оцінювали</span>` : '';

            html += `
                <div class="review-item mb-4 p-3" data-target="${user.target_id}" style="background:var(--gf-dark);border-radius:10px;">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        ${avatarHtml}
                        <div>
                            <strong style="color:var(--gf-text)">${user.username}</strong>
                            ${editBadge}
                        </div>
                    </div>
                    ${renderReviewStars(user.target_id, isPositive)}
                    <textarea class="form-control form-control-sm review-comment" placeholder="Коментар (необов'язково)" rows="2">${comment}</textarea>
                </div>
            `;
        });
        body.innerHTML = html;
    } catch(e) {
        console.error(e);
        document.getElementById('reviewModalBody').innerHTML = '<p class="text-danger">Помилка завантаження даних.</p>';
    }
}

async function submitReviews() {
    const items = document.querySelectorAll('.review-item');
    let reviews = [];
    items.forEach(item => {
        let targetId = item.getAttribute('data-target');
        let radio = item.querySelector(`input[name="rating_${targetId}"]:checked`);
        let comment = item.querySelector('.review-comment').value;
        if (radio) {
            reviews.push({
                target_id: targetId,
                isPositive: radio.value === 'positive',
                comment: comment
            });
        }
    });

    if (reviews.length === 0) {
        reviewModalInstance.hide();
        return;
    }

    const btn = document.getElementById('btnSubmitReviews');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Збереження...';

    try {
        const res = await fetch(reviewSubmitUrl, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ lobby_id: lobbyId, reviews: reviews })
        });
        const json = await res.json();
        if (json.success) {
            reviewModalInstance.hide();
            window.location.href = '{{ path("app_lobbies") }}';
        } else {
            alert(json.error || 'Помилка збереження.');
            btn.disabled = false;
            btn.innerHTML = 'Зберегти відгуки';
        }
    } catch(e) {
        alert('Помилка сервера');
        btn.disabled = false;
        btn.innerHTML = 'Зберегти відгуки';
    }
}

document.addEventListener('DOMContentLoaded', () => {
    if (isParticipant) {
        reviewModalInstance = new bootstrap.Modal(document.getElementById('reviewModal'));
        document.getElementById('btnSubmitReviews').addEventListener('click', submitReviews);

        try {
            const url = new URL('{{ mercure("https://gamefinder.com/lobby/" ~ lobby.id)|escape("js") }}');
            const eventSource = new EventSource(url);

            eventSource.onmessage = event => {
                const data = JSON.parse(event.data);
                if (data.action === 'trigger_review_modal') {
                    lobbyClosedHandled = true;
                    loadReviewData();
                    reviewModalInstance.show();
                }
            };
        } catch(e) {}

        {% if lobby.status == 'closed' %}
            lobbyClosedHandled = true;
            loadReviewData();
            reviewModalInstance.show();
        {% endif %}
    }
});
</script>
{% endblock %}
