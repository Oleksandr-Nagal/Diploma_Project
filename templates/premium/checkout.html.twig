{% extends 'base.html.twig' %}

{% block title %}Оплата Premium{% endblock %}

{% block stylesheets %}
<style>
    .checkout-container {
        max-width: 500px;
        margin: 2rem auto;
        text-align: center;
    }
    .checkout-card {
        background: var(--gf-card);
        border: 1px solid var(--gf-border);
        border-radius: 12px;
        padding: 2rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="checkout-container">
    <div class="checkout-card">
        <i class="fas fa-spinner fa-spin fa-3x mb-3" style="color:var(--gf-primary)"></i>
        <h4>Перенаправлення на сторінку оплати...</h4>
        <p style="color:var(--gf-muted)">Якщо перенаправлення не відбулось автоматично, натисніть кнопку нижче.</p>
        <a href="{{ path('app_premium') }}" class="btn btn-gf-outline">Повернутись</a>
    </div>
</div>
{% endblock %}
