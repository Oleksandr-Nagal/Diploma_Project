{% extends 'base.html.twig' %}

{% block title %}Створити подію{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="page-header">
            <h1><i class="fas fa-calendar-plus me-2" style="color:var(--gf-warning)"></i>Створити подію</h1>
        </div>

        <div class="card-gf">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Назва події</label>
                    <input type="text" name="title" class="form-control" required placeholder="Наприклад: Турнір CS2 5v5">
                </div>
                <div class="mb-3">
                    <label class="form-label">Опис</label>
                    <textarea name="description" class="form-control" rows="3" placeholder="Деталі події..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Гра</label>
                    <select name="game_id" class="form-select" required>
                        <option value="">Оберіть гру</option>
                        {% for game in games %}
                            <option value="{{ game.id }}">{{ game.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Початок</label>
                            <input type="datetime-local" name="start_at" id="startAt" class="form-control" required max="2030-12-31T23:59">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Кінець (опціонально)</label>
                            <input type="datetime-local" name="end_at" id="endAt" class="form-control" max="2030-12-31T23:59">
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Макс. учасників</label>
                    <input type="number" name="max_participants" class="form-control" value="10" min="2" max="100">
                </div>

                <button type="submit" class="btn btn-gf"><i class="fas fa-calendar-check me-1"></i> Створити подію</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    const startAt = document.getElementById('startAt');
    const endAt = document.getElementById('endAt');
    const form = startAt.closest('form');

    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    const nowStr = now.toISOString().slice(0, 16);
    startAt.min = nowStr;
    endAt.min = nowStr;

    startAt.addEventListener('change', () => {
        if (startAt.value) {
            endAt.min = startAt.value;
            if (endAt.value && endAt.value <= startAt.value) {
                endAt.value = '';
            }
        }
    });

    form.addEventListener('submit', (e) => {
        const startVal = new Date(startAt.value);
        const nowCheck = new Date();

        if (startVal < nowCheck) {
            e.preventDefault();
            alert('Дата початку не може бути у минулому.');
            return;
        }

        if (startVal.getFullYear() > 2030) {
            e.preventDefault();
            alert('Рік не може перевищувати 2030.');
            return;
        }

        if (endAt.value) {
            const endVal = new Date(endAt.value);
            if (endVal <= startVal) {
                e.preventDefault();
                alert('Дата кінця повинна бути пізніше дати початку.');
                return;
            }
            if (endVal.getFullYear() > 2030) {
                e.preventDefault();
                alert('Рік кінця не може перевищувати 2030.');
                return;
            }
        }
    });
})();
</script>
{% endblock %}
