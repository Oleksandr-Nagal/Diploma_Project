{% extends 'base.html.twig' %}

{% block title %}Адмін-панель{% endblock %}

{% block body %}
<div class="page-header">
    <h1><i class="fas fa-shield me-2" style="color:var(--gf-warning)"></i>Панель адміністратора</h1>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card-gf text-center">
            <div class="stat-value">{{ totalUsers }}</div>
            <div class="stat-label">Користувачів</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-gf text-center">
            <div class="stat-value">{{ totalGames }}</div>
            <div class="stat-label">Ігор</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-gf text-center">
            <div class="stat-value" style="font-size:1.2rem;">v1.0</div>
            <div class="stat-label">Версія</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <a href="{{ path('app_admin_users') }}" class="card-gf d-block text-decoration-none">
            <h4 style="color:var(--gf-text)"><i class="fas fa-users me-2" style="color:var(--gf-primary)"></i>Управління користувачами</h4>
            <p style="color:var(--gf-muted)">Ролі, блокування, модерація</p>
        </a>
    </div>
    <div class="col-md-6">
        <a href="{{ path('app_admin_games') }}" class="card-gf d-block text-decoration-none">
            <h4 style="color:var(--gf-text)"><i class="fas fa-gamepad me-2" style="color:var(--gf-secondary)"></i>Управління іграми</h4>
            <p style="color:var(--gf-muted)">Додавання та редагування каталогу</p>
        </a>
    </div>
</div>
{% endblock %}
